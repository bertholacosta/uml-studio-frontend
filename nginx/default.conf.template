server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # El backend se resuelve en cada petición: nginx arranca aunque aún no exista
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
    set $backend ${BACKEND_UPSTREAM};

    client_max_body_size 16m;

    gzip on;
    gzip_comp_level 6;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # add_header dentro de un location anula los del server: cada bloque incluye las cabeceras
    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # API REST del backend (mismo dominio: sin CORS)
    location /api/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Trazo puede tardar si el proveedor de IA está saturado
        proxy_read_timeout 180s;
    }

    # Colaboración en tiempo real (Socket.IO con WebSocket)
    location /socket.io/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    # JS y CSS de Angular llevan un hash en el nombre (main-AB12CD34.js): se cachean para siempre
    location ~* -[a-z0-9_-]{8}\.(?:js|css)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Logos e iconos tienen nombre fijo: caché corta
    location ~* \.(?:png|svg|ico|woff2?)$ {
        expires 1d;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # index.html y config.js nunca se cachean, para que un despliegue se vea al instante
    location = /config.js {
        add_header Cache-Control "no-store";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
